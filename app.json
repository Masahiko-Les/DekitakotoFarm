{
  "expo": {
    "name": "できたこと農園",
    "slug": "dekitakoto-farm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dekitakotofarm",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.masahikofujita.dekitakotofarm"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7fae5a",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.masahikofujita.dekitakotofarm"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4f6b3a",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#2f6b34",
    "owner": "mfujita.jp",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d71743fc-b940-4b59-99b9-fed2faa4bf7c"
      }
    }
  }
}
